# 生产环境必须替换所有示例值，且不得提交真实凭据。
AI_HUB_ADMIN_WORKCODE=1000000
AI_HUB_ADMIN_PASSWORD={bcrypt}$2a$12$replace.with.a.real.bcrypt.hash
AI_HUB_MASTER_KEY=base64-encoded-32-byte-key
AI_HUB_JWT_JWK_SET_URI=https://gateway.example.com/.well-known/jwks.json
AI_HUB_JWT_ISSUER=https://gateway.example.com
AI_HUB_JWT_AUDIENCE=dsh-harness
AI_HUB_INTERNAL_API_KEY=replace-with-a-long-random-gateway-service-key
AI_HUB_EXTENSION_HOST_ENABLED=true
AI_HUB_EXTENSION_HOST_REQUIRED=true
AI_HUB_EXTENSION_HOST_URL=http://127.0.0.1:8091
AI_HUB_EXTENSION_HOST_PORT=8091
AI_HUB_EXTENSION_HOST_BIND_ADDRESS=127.0.0.1
AI_HUB_EXTENSION_HOST_API_KEY=replace-with-a-separate-long-extension-service-key
AI_HUB_EXTENSION_HOST_REQUIRED_PLUGINS=gateway-catalog,skill-artifact,conversation-audit,manual-key-maintenance
AI_HUB_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/ai_hub?currentSchema=ai_hub
AI_HUB_DATABASE_SCHEMA=ai_hub
AI_HUB_DATABASE_USERNAME=ai_hub
AI_HUB_DATABASE_PASSWORD=replace-me
AI_HUB_BIND_ADDRESS=127.0.0.1
